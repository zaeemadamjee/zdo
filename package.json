{
  "name": "@zaeemadamjee/zdo",
  "version": "0.1.0",
  "description": "A small local todo app for the terminal, built with Bun and OpenTUI",
  "license": "MIT",
  "author": "Zaeem Adamjee",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaeemadamjee/zdo.git"
  },
  "homepage": "https://github.com/zaeemadamjee/zdo#readme",
  "bugs": "https://github.com/zaeemadamjee/zdo/issues",
  "keywords": ["todo", "tui", "terminal", "bun", "opentui", "react"],
  "bin": {
    "zdo": "./src/main.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/main.tsx",
    "start": "bun src/main.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun scripts/verify.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.10",
    "@opentui/react": "0.5.10",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
